# --- Supabase Postgres -------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session" pooler URI (port 5432) for a long-lived Node server.
# This is a SECRET. Never commit the real value; set it in Render's env panel.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Tutor dashboard gate ----------------------------------------------------
# Shared secret in the tutor URL: /t/<TUTOR_SECRET>. Pick something unguessable.
TUTOR_SECRET=change-me

# --- Local dev only ----------------------------------------------------------
# PORT=5959
